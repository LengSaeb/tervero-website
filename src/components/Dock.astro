---
// Sticky bottom call-to-action bar, shown on phones only (thumb zone).
import { t, href, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<div class="dock">
  <a class="btn primary" href={href(locale, 'contact')}>{d.cta.book}</a>
  <a class="btn signal" href={href(locale, 'check')}>{d.cta.check}</a>
</div>

<style>
  .dock { position: sticky; bottom: 0; z-index: 9; display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); background: rgba(255, 255, 255, 0.96); border-top: 1px solid var(--line); backdrop-filter: blur(8px); }
  .dock .btn { flex: 1; padding: 0 8px; font-size: 14px; white-space: normal; text-align: center; line-height: 1.2; }
  @media (min-width: 720px) { .dock { display: none; } }
</style>
