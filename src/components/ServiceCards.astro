---
// The three service lines as compact cards; each links to its section on the services page.
import { t, href, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const order = ['compliance', 'fde', 'ai'] as const;
---

<div class="grid three">
  {order.map((key, i) => {
    const s = d.services[key];
    return (
      <a class="card svc" href={`${href(locale, 'services')}#${key}`}>
        <span class="num">0{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.short}</p>
        <span class="tags">{d.servicesPage.advise} + {d.servicesPage.deliver} →</span>
      </a>
    );
  })}
</div>

<style>
  .svc { display: flex; flex-direction: column; gap: 6px; color: inherit; text-decoration: none; }
  .svc:hover { border-color: var(--ink); }
  .num { font-weight: 800; font-size: 13px; color: var(--mute); }
  .tags { margin-top: auto; padding-top: 8px; font-weight: 700; font-size: 14px; color: var(--link); }
</style>
