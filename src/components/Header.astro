---
// Minimal header: wordmark left, mark centred, menu button right; the menu is a full-screen dark overlay.
import { t, href, switchLocale, locales, type Locale } from '../i18n';
import { localeLabel, localeName, site } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const path = Astro.url.pathname;
const links = [
  ['services', d.nav.services],
  ['engagement', d.nav.engagement],
  ['about', d.nav.about],
  ['contact', d.nav.contact],
] as const;
---

<header class="hdr">
  <a class="word" href={href(locale)} aria-label={`${site.brand} home`}>{site.brand}<span>{site.brandZh}</span></a>
  <a class="mark" href={href(locale)} aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 28 28" width="28" height="28"><circle cx="14" cy="14" r="12.5" fill="none" stroke="currentColor" stroke-width="1" /><path d="M8 9.5h12M14 9.5v10" stroke="currentColor" stroke-width="1.6" /><circle cx="14" cy="22.5" r="1.6" fill="var(--signal)" stroke="currentColor" stroke-width=".8" /></svg>
  </a>
  <button class="menu-btn" type="button" aria-controls="site-menu" aria-expanded="false" data-open={d.nav.menu} data-close={d.nav.close}>
    <span class="lbl">{d.nav.menu}</span><i aria-hidden="true"></i>
  </button>
</header>

<div class="overlay" id="site-menu" hidden>
  <nav aria-label="Main">
    {links.map(([page, label], i) => (
      <a href={href(locale, page)} style={`--i:${i}`} aria-current={path.startsWith(href(locale, page)) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <div class="ov-foot">
    <a class="btn light" href={href(locale, 'contact')}>{d.cta.book}</a>
    <div class="lang" role="group" aria-label={d.nav.language}>
      {locales.map((l) => (
        <a href={switchLocale(path, l)} hreflang={l} lang={l} title={localeName[l]} aria-current={l === locale ? 'true' : undefined}>{localeLabel[l]}</a>
      ))}
    </div>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const ov = document.querySelector<HTMLElement>('#site-menu');
  const lbl = btn?.querySelector('.lbl');
  const set = (open: boolean) => {
    if (!btn || !ov) return;
    btn.setAttribute('aria-expanded', String(open));
    if (lbl) lbl.textContent = (open ? btn.dataset.close : btn.dataset.open) ?? '';
    document.documentElement.classList.toggle('menu-open', open);
    if (open) { ov.hidden = false; requestAnimationFrame(() => ov.classList.add('show')); }
    else { ov.classList.remove('show'); setTimeout(() => { ov.hidden = true; }, 400); }
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.hreflang); } catch { /* storage unavailable */ } }),
  );
</script>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 30; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 16px var(--gutter); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(10px); }
  .word { justify-self: start; font: 600 14px/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; color: var(--ink); }
  .word span { margin-left: 8px; letter-spacing: 0.02em; color: var(--mute); font-weight: 400; }
  .mark { color: var(--ink); display: grid; }
  .menu-btn { justify-self: end; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; font: 500 13px/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; }
  .menu-btn i { width: 18px; height: 18px; position: relative; }
  .menu-btn i::before, .menu-btn i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform 0.35s var(--ease); }
  .menu-btn i::before { transform: translateY(-4px); }
  .menu-btn i::after { transform: translateY(4px); }
  :global(.menu-open) .hdr { background: transparent; backdrop-filter: none; }
  :global(.menu-open) .hdr, :global(.menu-open) .word, :global(.menu-open) .mark, :global(.menu-open) .menu-btn { color: var(--on-night); }
  :global(.menu-open) .word span { color: #8d989c; }
  :global(.menu-open) .menu-btn i::before { transform: rotate(45deg); }
  :global(.menu-open) .menu-btn i::after { transform: rotate(-45deg); }
  :global(.menu-open) body { overflow: hidden; }
  .overlay { position: fixed; inset: 0; z-index: 25; background: var(--night); color: var(--on-night); display: flex; flex-direction: column; justify-content: center; padding: 96px var(--gutter) 40px; opacity: 0; transition: opacity 0.4s var(--ease); }
  .overlay.show { opacity: 1; }
  .overlay nav { display: flex; flex-direction: column; gap: clamp(8px, 2vh, 20px); margin-left: clamp(0px, 32vw, 520px); }
  .overlay nav a { font: var(--dw) clamp(40px, 7vw, 72px)/1.1 var(--serif); text-decoration: none; color: var(--on-night); opacity: 0; transform: translateY(18px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease), color 0.2s; transition-delay: calc(var(--i) * 60ms + 80ms); }
  .overlay.show nav a { opacity: 1; transform: none; }
  .overlay nav a:hover, .overlay nav a[aria-current='page'] { color: var(--signal); }
  .ov-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin: clamp(32px, 6vh, 64px) 0 0 clamp(0px, 32vw, 520px); }
  .lang { display: flex; gap: 18px; }
  .lang a { font: 500 13px/1 var(--sans); letter-spacing: 0.08em; text-decoration: none; color: #8d989c; padding: 10px 0; }
  .lang a[aria-current='true'] { color: var(--on-night); border-bottom: 1px solid currentColor; }
  @media (max-width: 600px) { .word span { display: none; } .menu-btn .lbl { display: none; } }
  @media (prefers-reduced-motion: reduce) { .overlay, .overlay nav a { transition: none; } }
</style>
