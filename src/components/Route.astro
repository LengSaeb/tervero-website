---
// The "route into the EU market": six stations. Picking a station marks it as
// "you are here" and highlights the matching service card on the page.
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; here?: number }
const { locale, here = 2 } = Astro.props;
const d = t(locale);
---

<div class="route">
  <p class="rt">{d.home.routeTitle}</p>
  <ol class="stops">
    {d.home.stations.map((s, i) => (
      <li>
        <button type="button" class:list={['stop', { here: i === here }]} aria-pressed={i === here ? 'true' : 'false'} data-service={s.service}>
          <span class="dot" aria-hidden="true"></span>
          <span class="txt"><b>{s.name}</b><small>{s.note}</small></span>
        </button>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.route').forEach((route) => {
    const stops = [...route.querySelectorAll<HTMLButtonElement>('.stop')];
    stops.forEach((btn) =>
      btn.addEventListener('click', () => {
        stops.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('here', on);
          b.setAttribute('aria-pressed', String(on));
        });
        document.querySelectorAll<HTMLElement>('[data-services] [data-service]').forEach((card) => {
          card.classList.toggle('on', card.dataset.service === btn.dataset.service);
        });
      }),
    );
  });
</script>

<style>
  .route { background: var(--paper); border-block: 1px solid #e6e6e0; padding: 26px var(--gutter) 30px; }
  .rt { font-size: 15px; color: var(--mute); max-width: var(--max); margin: 0 auto 14px; }
  .stops { list-style: none; margin: 0 auto; padding: 0; max-width: var(--max); display: grid; grid-template-columns: minmax(0, 1fr); position: relative; }
  .stops::before { content: ''; position: absolute; left: 13px; top: 12px; bottom: 12px; width: 6px; background: var(--ink); border-radius: 3px; }
  .stop { all: unset; box-sizing: border-box; display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 14px; align-items: start; width: 100%; padding: 0 0 14px; cursor: pointer; min-height: 48px; }
  .stop:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; border-radius: 4px; }
  .dot { position: relative; width: 32px; height: 32px; border-radius: 50%; background: #fff; border: 5px solid var(--ink); }
  li:last-child .dot { border-style: double; border-width: 7px; }
  .here .dot { background: var(--signal); }
  .txt b { display: block; font-size: 16px; line-height: 1.3; }
  .txt small { display: block; font-size: 14px; color: var(--mute); line-height: 1.35; margin-top: 2px; }
  @media (min-width: 900px) {
    .stops { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .stops::before { left: 8%; right: 8%; top: 13px; bottom: auto; width: auto; height: 6px; }
    .stop { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: 10px; padding: 0 4px; }
  }
</style>
