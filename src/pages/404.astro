---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
const d = t('en');
---

<Base locale="en" title={d.notFound.title}>
  <section class="band page-head">
    <div class="wrap">
      <h1>{d.notFound.title}</h1>
      <p class="lead">{d.notFound.text}</p>
      <p><a href="/en/">{d.notFound.home}</a> · <a href="/zh/" lang="zh-CN">返回首页</a> · <a href="/de/" lang="de">Zur Startseite</a></p>
    </div>
  </section>
</Base>
