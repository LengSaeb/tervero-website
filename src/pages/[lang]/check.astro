---
// Tools page. The German EPR self-check is the first tool; more follow.
import Base from '../../layouts/Base.astro';
import EprCheck from '../../components/EprCheck.astro';
import { t, href, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base locale={locale} title={d.tools.title} description={d.tools.lead}>
  <section class="band">
    <div class="wrap">
      <h1>{d.tools.title}</h1>
      <p class="lead">{d.tools.lead}</p>
    </div>
  </section>
  <section class="band paper" id="epr">
    <div class="wrap">
      <h2>{d.check.title}</h2>
      <p>{d.check.lead}</p>
      <div style="margin-top:20px"><EprCheck locale={locale} /></div>
      <p class="small" style="margin-top:16px">{d.check.disclaimer}</p>
      <p style="margin-top:12px"><b>{d.check.moreTitle}</b> {d.check.moreText}</p>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div>
        <h2>{d.tools.nextTitle}</h2>
        <ul class="next">{d.tools.next.map((n) => <li>{n}</li>)}</ul>
      </div>
      <div class="card">
        <h3>{d.home.ctaTitle}</h3>
        <p>{d.home.ctaText}</p>
        <a class="btn primary" href={href(locale, 'contact')}>{d.cta.book}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .next { margin: 0; padding-left: 20px; font-size: 17px; }
  .next li { margin-bottom: 8px; }
</style>
