---
import Base from '../../layouts/Base.astro';
import { t, href, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
const e = d.engagement;
---

<Base locale={locale} title={e.title} description={e.lead}>
  <section class="band">
    <div class="wrap">
      <h1>{e.title}</h1>
      <p class="lead">{e.lead}</p>
    </div>
  </section>
  {e.models.map((m, i) => (
    <section class:list={['band', { paper: i % 2 === 0 }]}>
      <div class="wrap split">
        <div>
          <h2>{m.t}</h2>
          <p class="lead">{m.d}</p>
        </div>
        <dl class="facts">
          <div><dt>{e.fitLabel}</dt><dd>{m.fit}</dd></div>
          <div><dt>{e.billingLabel}</dt><dd>{m.billing}</dd></div>
        </dl>
      </div>
    </section>
  ))}
  <section class="band">
    <div class="wrap">
      <h2>{d.home.stepsTitle}</h2>
      <ol class="steps">{d.steps.map((s) => <li><b>{s.t}</b><span>{s.d}</span></li>)}</ol>
      <div class="ctas"><a class="btn primary" href={href(locale, 'contact')}>{d.cta.book}</a></div>
    </div>
  </section>
</Base>
