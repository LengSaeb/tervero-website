---
import Base from '../../layouts/Base.astro';
import { t, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base locale={locale} title={d.insights.title} description={d.insights.lead}>
  <section class="band">
    <div class="wrap">
      <h1>{d.insights.title}</h1>
      <p class="lead">{d.insights.lead}</p>
    </div>
  </section>
  <section class="band paper">
    <div class="wrap split">
      <div>
        <h2>{d.home.timelineTitle}</h2>
        <ol class="timeline">{d.timeline.map((r) => <li><time datetime={r.date}>{r.date}</time><span>{r.text}</span></li>)}</ol>
        <p class="small" style="margin-top:10px">{d.home.timelineNote}</p>
      </div>
      <div>
        <h2>{d.insights.regsTitle}</h2>
        <ul class="regs">
          {d.insights.regs.map((r) => (
            <li><code>{r.code}</code><div><b>{r.name}</b><p>{r.desc}</p></div></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .regs { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .regs li { display: grid; grid-template-columns: 4.5em minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .regs code { font: inherit; font-weight: 800; font-size: 14px; }
  .regs p { margin: 2px 0 0; font-size: 15px; color: var(--mute); }
</style>
