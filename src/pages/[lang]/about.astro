---
import Base from '../../layouts/Base.astro';
import { t, href, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base locale={locale} title={d.about.title} description={d.about.lead}>
  <section class="band">
    <div class="wrap split">
      <div>
        <h1>{d.about.title}</h1>
        <p class="lead">{d.about.lead}</p>
      </div>
      <div>
        {d.about.paras.map((p) => <p>{p}</p>)}
        <h2 style="margin-top:28px">{d.about.factsTitle}</h2>
        <dl class="facts">{d.about.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        <div class="ctas"><a class="btn primary" href={href(locale, 'contact')}>{d.cta.contact}</a></div>
      </div>
    </div>
  </section>
</Base>
