---
// Privacy policy (Datenschutzerklärung). DRAFT, not legally reviewed. German text is binding.
// Keep in sync with what the site actually does: no cookies, no analytics, self-hosted fonts.
import Base from '../../layouts/Base.astro';
import { t, localePaths, type Locale } from '../../i18n';
import { site } from '../../config';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base locale={locale} title={d.legal.privacy}>
  <section class="band">
    <div class="wrap prose" lang="de">
      <h1>Datenschutzerklärung</h1>
      <p class="notice" lang={locale === 'zh' ? 'zh-CN' : locale}>{d.legal.draft} {locale !== 'de' && d.legal.germanBinding}</p>
      <h2>1. Verantwortlicher</h2>
      <p>{site.legalName}, {site.city}. Kontaktdaten siehe Impressum.</p>
      <h2>2. Hosting</h2>
      <p>Diese Website wird bei Vercel Inc. (USA) gehostet. Beim Aufruf der Seiten verarbeitet der Hoster technisch notwendige Daten wie IP-Adresse, Zeitpunkt des Abrufs und Browserinformationen, um die Website auszuliefern und abzusichern (Art. 6 Abs. 1 lit. f DSGVO). Mit dem Hoster besteht ein Auftragsverarbeitungsvertrag; die Übermittlung in die USA stützt sich auf das EU-US Data Privacy Framework bzw. Standardvertragsklauseln.</p>
      <h2>3. Keine Cookies, kein Tracking</h2>
      <p>Diese Website setzt keine Cookies und verwendet keine Analyse- oder Marketing-Dienste. Schriftarten werden von unserem eigenen Server geladen, nicht von Drittanbietern.</p>
      <h2>4. Kontaktaufnahme</h2>
      <p>Wenn Sie uns per E-Mail kontaktieren, verarbeiten wir Ihre Angaben ausschließlich zur Bearbeitung Ihrer Anfrage (Art. 6 Abs. 1 lit. b und f DSGVO) und löschen sie, sobald sie nicht mehr erforderlich sind und keine gesetzlichen Aufbewahrungspflichten bestehen.</p>
      <h2>5. Ihre Rechte</h2>
      <p>Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Datenübertragbarkeit und Widerspruch (Art. 15 bis 21 DSGVO). Sie können sich außerdem bei einer Datenschutzaufsichtsbehörde beschweren, zum Beispiel bei der Berliner Beauftragten für Datenschutz und Informationsfreiheit.</p>
    </div>
  </section>
</Base>
