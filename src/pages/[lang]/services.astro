---
import Base from '../../layouts/Base.astro';
import { t, href, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
const order = ['compliance', 'fde', 'ai', 'ongoing'] as const;
---

<Base locale={locale} title={d.servicesPage.title} description={d.servicesPage.lead}>
  <section class="band">
    <div class="wrap">
      <h1>{d.servicesPage.title}</h1>
      <p class="lead">{d.servicesPage.lead}</p>
    </div>
  </section>
  {order.map((key, i) => {
    const s = d.services[key];
    return (
      <section class:list={['band', { paper: i % 2 === 0 }]} id={key}>
        <div class="wrap split">
          <div>
            <h2>{s.title}</h2>
            <p class="lead">{s.short}</p>
          </div>
          <ul class="list">{s.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>
    );
  })}
  <section class="band">
    <div class="wrap">
      <h2>{d.home.stepsTitle}</h2>
      <ol class="steps">{d.steps.map((s) => <li><b>{s.t}</b><span>{s.d}</span></li>)}</ol>
      <div class="ctas"><a class="btn primary" href={href(locale, 'contact')}>{d.cta.book}</a></div>
    </div>
  </section>
</Base>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .list li { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 17px; font-weight: 700; }
</style>
