---
import Base from '../../layouts/Base.astro';
import { t, href, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const d = t(locale);
const order = ['compliance', 'fde', 'ai'] as const;
---

<Base locale={locale} title={d.servicesPage.title} description={d.servicesPage.lead}>
  <section class="band page-head">
    <div class="wrap">
      <h1>{d.servicesPage.title}</h1>
      <p class="lead">{d.servicesPage.lead}</p>
    </div>
  </section>
  {order.map((key, i) => {
    const s = d.services[key];
    return (
      <section class:list={['band', { paper: i % 2 === 0 }]} id={key}>
        <div class="wrap split">
          <div>
            <span class="num">0{i + 1}</span>
            <h2>{s.title}</h2>
            <p class="lead">{s.short}</p>
          </div>
          <div class="cols">
            <div><h3>{d.servicesPage.advise}</h3><ul class="list">{s.advise.map((item) => <li>{item}</li>)}</ul></div>
            <div><h3>{d.servicesPage.deliver}</h3><ul class="list">{s.deliver.map((item) => <li>{item}</li>)}</ul></div>
          </div>
        </div>
      </section>
    );
  })}
  <section class="band">
    <div class="wrap">
      <h2>{d.home.stepsTitle}</h2>
      <ol class="steps">{d.steps.map((s) => <li><b>{s.t}</b><span>{s.d}</span></li>)}</ol>
      <div class="ctas"><a class="btn primary" href={href(locale, 'contact')}>{d.cta.book}</a></div>
    </div>
  </section>
</Base>

<style>
  .num { font: 500 13px/1 var(--sans); letter-spacing: 0.08em; color: var(--mute); display: block; margin-bottom: 14px; }
  .cols { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
  .cols h3 { font: 500 13px/1.4 var(--sans); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; color: var(--mute); }
  .cols > div:last-child h3 { color: var(--ink); }
  @media (min-width: 720px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .list li { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 16px; }
</style>
