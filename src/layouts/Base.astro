---
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/newsreader/300.css';
import '@fontsource/noto-serif-sc/300.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, switchLocale, locales, defaultLocale, type Locale } from '../i18n';
import { htmlLang, site } from '../config';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const d = t(locale);
const pageTitle = title ? `${title} · Tervero` : d.meta.title;
const pageDescription = description ?? d.meta.description;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(switchLocale(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocale(path, defaultLocale), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#fafaf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{d.nav.skip}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // Reveal elements as they enter the viewport, and expose scroll progress (0..1)
      // of [data-scroll] sections as --p for scroll-linked graphics.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      const secs = [...document.querySelectorAll<HTMLElement>('[data-scroll]')];
      let ticking = false;
      const update = () => {
        ticking = false;
        for (const el of secs) {
          const r = el.getBoundingClientRect();
          const span = Math.max(1, r.height - innerHeight);
          el.style.setProperty('--p', String(Math.min(1, Math.max(0, -r.top / span))));
        }
      };
      if (!reduce && secs.length) {
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
